# sofka configuration
# Reference: https://github.com/nklmilojevic/sofka/blob/main/docs/configuration.md

mouse = true
compact_mode = true

[skin]
name = "gruvbox-dark"

# k9s CPU/MEM coloring bands (percent of request/limit)
[thresholds]
utilization = { warn = 70, critical = 90 }

[aliases]
cr = "clusterroles"
crb = "clusterrolebindings"
rb = "rolebindings"
np = "networkpolicies"

# AGE must be the rightmost column. An overlay view cannot move a column,
# so this view replaces the curated pods columns instead of overlaying them.
[views."v1/pods"]
replace = true
columns = [
  { name = "NAME", builtin = "NAME" },
  { name = "READY", builtin = "READY" },
  { name = "STATUS", builtin = "STATUS" },
  { name = "RESTARTS", builtin = "RESTARTS" },
  { name = "IP", builtin = "IP", wide = true },
  { name = "NODE", builtin = "NODE", wide = true },
  { name = "CPU", metric = "cpu" },
  { name = "MEM", metric = "memory" },
  { name = "AGE", builtin = "AGE" },
]
