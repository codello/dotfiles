// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Feature Flags
  "feature_flags": {
    "sandboxing": "on",
    "create-thread-tool": "on",
  },

  // Extensions
  "auto_install_extensions": {
    // Themes and Visuals
    "jetbrains-themes": true,
    "catppuccin-icons": true,
    // Languages
    "comment": true, // highlights todo comments
    "dockerfile": true,
    "gotmpl": true,
    "html": true,
    "toml": true,
  },

  // General Settings
  "base_keymap": "JetBrains",
  "cli_default_open_behavior": "new_window",

  // Appearance & Layout
  "icon_theme": "Catppuccin Latte",
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark",
  },
  "drop_target_size": 0.35,
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "status_bar": {
    "line_endings_button": true,
  },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "diagnostic_badges": true,
  },
  "git_panel": {
    "dock": "left",
    "sort_by": "path",
  },

  // Fonts
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13.0,
  "buffer_font_weight": 300.0,
  "buffer_line_height": {
    "custom": 1.35,
  },

  // Editor Experience
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "close_on_file_delete": true,
  "auto_signature_help": false,
  "show_signature_help_after_edits": true,
  "gutter": {
    "min_line_number_digits": 3,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.75,
  },
  "colorize_brackets": true,
  "wrap_guides": [80, 120],
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "scrollbar": {
    "show": "system",
  },
  "unnecessary_code_fade": 0.4,

  // Code Intelligence
  "inlay_hints": {
    "enabled": true,
    "edit_debounce_ms": 0,
    "scroll_debounce_ms": 0,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "padding": 8,
    },
  },

  // Git Integration
  "diff_view_style": "unified",
  "git": {
    "branch_picker": {
      "show_author_name": true,
    },
  },

  // Terminal
  "terminal": {
    "font_weight": 300.0,
    "font_family": "JetBrainsMono Nerd Font",
    "cursor_shape": "bar",
  },

  // Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Profiles
  "profiles": {
    "Presenting (Dark)": {
      "settings": {
        "theme": "JetBrains Dark",
        "agent_buffer_font_size": 18.0,
        "buffer_font_size": 18.0,
        "ui_font_size": 18.0,
      },
    },
    "Presenting (Light)": {
      "settings": {
        "theme": "JetBrains Light",
        "agent_buffer_font_size": 18.0,
        "buffer_font_size": 18.0,
        "ui_font_size": 18.0,
      },
    },
  },

  // Fily Type Associations
  "file_types": {
    "GitHub Actions": ["**/.github/workflows/*"],
    "Go Text Template": ["*.tpl", "**/templates/*.yaml"],
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml"
    ]
  },
   "file_scan_exclusions": [
    "...",
    "**/._*",
  ],

  // Language-specific Settings
  "languages": {
    "JavaScript": {
      "preferred_line_length": 120,
      "prettier": {
        "singleQuote": false,
      },
    },
    "Go Text Template": {
      "tab_size": 2,
    },
  },

  // AI Settings
  "show_edit_predictions": {{ .personal }},
  "edit_predictions": {
    "allow_data_collection": "no",
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "provider": "copilot",
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "show_turn_stats": true,
    "thinking_display": "auto",
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "enable_feedback": false,

    "commit_message_include_project_rules": false,
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "openrouter/auto",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "openrouter/free",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "deepseek/deepseek-v4.1-flash",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openrouter",
        "model": "deepseek/deepseek-v4-flash-0731",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3-flash",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3",
        "enable_thinking": true,
        "effort": "high",
      },
      {{- if .work }}
      {
        "provider": "litellm",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true,
        "effort": "high",
      },
      {{- end }}
    ],
    "default_model": {
      "provider": "open_router",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
      "effort": "high",
    },
    "subagent_model": {
      "provider": "open_router",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
      "effort": "high",
    },
    "inline_assistant_model": {
      "provider": "open_router",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
      "effort": "low",
    },
    "commit_message_model": {
      "provider": "open_router",
      "model": "deepseek/deepseek-v4-flash-0731",
      "enable_thinking": false,
    },
    "thread_summary_model": {
      "provider": "open_router",
      "model": "deepseek/deepseek-v4-flash-0731",
      "enable_thinking": false,
    },

    "default_profile": "agent",
    "profiles": {
      "write": {
        "name": "Write",
        "enable_all_context_servers": false,
      },
      "agent": {
        "name": "Coding Agent",
        "enable_all_context_servers": true,
        "tools": {
          "ask_user": true,
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true,
        },
        "context_servers": {
          {{- includeTemplate "private_dot_config/zed/.mcp/enabled-tools.tmpl" . }}
        },
      },
    },
    "tool_permissions": {
      "tools": {
        // Integrated Tools
        "fetch": { "default": "allow" },
        "create_directory": { "default": "allow" },
        "copy_path": { "default": "allow" },
        "delete_path": { "default": "allow" },
        "terminal": {
          "always_allow": [
            { "pattern": "^printenv TMPDIR$" },
            // Command Introspection
            { "pattern": "^(which|whereis|type|command -v)" },
            // File and Directory Operations
            { "pattern": "^(pwd|dirname|basename|readlink|realpath|stat|file|mkdir)" },
            { "pattern": "^> $TMPDIR/" },
            // Standard Unix Commands
            { "pattern": "^(ls|grep|sed|awk|find|cat|head|tail|echo|wc|cut|sort|uniq|tr|diff|comm|cmp|sleep)" },
            // Typical Development Tools
            { "pattern": "^(jq|yq|git|xmllint|strings)" },
            { "pattern": "^pre-commit (help|run|validate-config|validate-manifest)" },
            // GitHub CLI read-only commands
            { "pattern": "^gh (--version|auth status|status|config get)" },
            { "pattern": "^gh repo (read-file|read-dir|gitignore|license)" },
            // DevOps Tooling
            { "pattern": "^(terraform|tofu) (init|plan|validate|fmt)" },
            { "pattern": "^tflint($| (--init))" },
            { "pattern": "^kustomize build|kubectl kustomize" },
            { "pattern": "^helm (template|show|lint|env|version|verify)" },
            { "pattern": "^helm repo (list)" },
            { "pattern": "^helm get (all|manifest|values|notes|hooks|metadata)" },
            // Language-specific Tooling
            { "pattern": "^cargo (build|check|test|fmt|clippy)" },
            { "pattern": "^go (env|build|test|fmt|vet|list|mod tidy)" },
            // Dotfiles and Configuration Management
            { "pattern": "^chezmoi (diff|status|data|execute-template)" },
          ],
          "always_confirm": [
            // always confirm writes via terminal tools, these don't land in the agent diff
            { "pattern": "^sed\\b.*(\\s-[a-z]*i[a-z]*\\b|--in-place\\b)" },
            { "pattern": "^awk\\b.*(>>?\\s*[\"']|system\\s*\\()" },
            { "pattern": "^find\\b.*(-delete\\b|-exec\\b|-execdir\\b|-ok\\b)" },
          ],
          "always_deny": [
            // never run find against the home directory
            { "pattern": "^find ({{ .chezmoi.homeDir }}|~)/?\\s" },
          ],
        },
        {{- includeTemplate "private_dot_config/zed/.mcp/tool-permissions.tmpl" . }}
      },
    },
    "sandbox_permissions": {
      "network_hosts": [
        // GitHub Content and Docs
        "github.com",
        "docs.github.com",
        "raw.githubusercontent.com",
        "release-assets.githubusercontent.com",

        // STACKIT Docs
        "docs.stackit.cloud",
        "docs.api.stackit.cloud",

        // Docs for Development Tooling
        "docs.renovatebot.com", // Renovate
        "pkg.go.dev",
      ],
      "write_paths": [
        // Helm config and caches
        "{{ .chezmoi.homeDir }}/.config/helm/",
        "{{ .chezmoi.homeDir }}/Library/Caches/helm/",
        // uv caches
        "{{ .chezmoi.homeDir }}/Library/Caches/uv/",
        // Terraform Cache
        "{{ .chezmoi.homeDir }}/Library/Caches/terraform/",
        // Go cache
        "/Users/kim.wittenburg/.local/share/go/pkg/sumdb/",
        "{{ .chezmoi.homeDir }}/Library/Caches/go/cache/",
        "{{ .chezmoi.homeDir }}/Library/Caches/go-build/",
      ],
      "allow_all_hosts": false,
    },
  },
  "context_servers": {
    {{- includeTemplate "private_dot_config/zed/.mcp/context-servers.tmpl" . }}
  },
  "agent_servers": {
    "{{ if .personal }}github-copilot-cli{{ end }}{{ if .work }}claude-acp{{ end }}": {
      "type": "registry",
    },
  },
  "language_models": {
    {{- if .work }}
    "litellm": {
      "api_url": "{{ (index (bitwarden "item" "AI Keys").login.uris 0).uri }}",
    },
    {{- end }}
    "open_router": {
      "available_models": [
        {
          "display_name": "DeepSeek V4 Flash 0731",
          "name": "deepseek/deepseek-v4-flash-0731",
          "max_tokens": 1048576,
          "max_output_tokens": 393200,
          "mode": { "type": "adaptive" },
          "reasoning_effort": "high",
          "supports_images": false,
          "supports_tools": true,
          "provider": {
            "only": ["relace", "reka", "fireworks"],
          },
        },
        {
          "display_name": "DeepSeek V4.1 Flash",
          "name": "deepseek/deepseek-v4.1-flash",
          "max_tokens": 1048576,
          "max_output_tokens": 393200,
          "mode": { "type": "adaptive" },
          "reasoning_effort": "high",
          "supports_images": true,
          "supports_tools": true,
          "provider": {
            "only": ["fireworks"],
          },
        },
        {
          "display_name": "GLM 5.3 Flash",
          "name": "z-ai/glm-5.3-flash",
          "max_tokens": 1048576,
          "max_output_tokens": 131072,
          "reasoning_effort": "high",
          "supports_images": true,
          "supports_tools": true,
          "provider": {
            "only": ["relace"],
          }
        }
      ],
    },
  },
}
