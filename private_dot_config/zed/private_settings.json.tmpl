// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Feature Flags
  "feature_flags": {
    "sandboxing": "on",
  },

  // Extensions
  "auto_install_extensions": {
    // Themes and Visuals
    "jetbrains-themes": true,
    "catppuccin-icons": true,
    // Languages
    "comment": true, // highlights todo comments
    "dockerfile": true,
    "gotmpl": true,
    "html": true,
    "toml": true,
  },

  // General Settings
  "base_keymap": "JetBrains",
  "cli_default_open_behavior": "new_window",

  // Appearance & Layout
  "icon_theme": "Catppuccin Latte",
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark",
  },
  "drop_target_size": 0.35,
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "status_bar": {
    "line_endings_button": true,
  },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "diagnostic_badges": true,
  },
  "git_panel": {
    "dock": "left",
    "sort_by": "path",
  },

  // Fonts
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13.0,
  "buffer_font_weight": 300.0,
  "buffer_line_height": {
    "custom": 1.35,
  },

  // Editor Experience
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "close_on_file_delete": true,
  "auto_signature_help": false,
  "show_signature_help_after_edits": true,
  "gutter": {
    "min_line_number_digits": 3,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.75,
  },
  "colorize_brackets": true,
  "wrap_guides": [80, 120],
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "scrollbar": {
    "show": "system",
  },
  "unnecessary_code_fade": 0.4,

  // Code Intelligence
  "inlay_hints": {
    "enabled": true,
    "edit_debounce_ms": 0,
    "scroll_debounce_ms": 0,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "padding": 8,
    },
  },

  // Git Integration
  "diff_view_style": "unified",
  "git": {
    "branch_picker": {
      "show_author_name": true,
    },
  },

  // Terminal
  "terminal": {
    "font_weight": 300.0,
    "font_family": "JetBrainsMono Nerd Font",
    "cursor_shape": "bar",
  },

  // Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Profiles
  "profiles": {
    "Presenting (Dark)": {
      "settings": {
        "theme": "JetBrains Dark",
        "agent_buffer_font_size": 18.0,
        "buffer_font_size": 18.0,
        "ui_font_size": 18.0,
      },
    },
    "Presenting (Light)": {
      "settings": {
        "theme": "JetBrains Light",
        "agent_buffer_font_size": 18.0,
        "buffer_font_size": 18.0,
        "ui_font_size": 18.0,
      },
    },
  },

  // Fily Type Associations
  "file_types": {
    "GitHub Actions": ["**/.github/workflows/*"],
    "Go Text Template": ["*.tpl", "**/templates/*.yaml"],
  },

  // Language-specific Settings
  "languages": {
    "JavaScript": {
      "preferred_line_length": 120,
      "prettier": {
        "singleQuote": false,
      },
    },
    "Go Text Template": {
      "tab_size": 2,
    },
  },

  // AI Settings
  "show_edit_predictions": {{ .personal }},
  "edit_predictions": {
    "allow_data_collection": "no",
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "provider": "copilot",
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "show_turn_stats": true,
    "thinking_display": "auto",
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "enable_feedback": false,

    "commit_message_include_project_rules": false,
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "openrouter/auto",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "openrouter/free",
        "enable_thinking": true,
      },
      {
        "provider": "OpenRouter (OpenAI Compatible)",
        "model": "z-ai/glm-5.2@preset/high",
        "enable_thinking": true,
      },
      {
        "provider": "OpenRouter (OpenAI Compatible)",
        "model": "deepseek/deepseek-v4-flash-0731@preset/high",
        "enable_thinking": true,
      },
      {
        "provider": "OpenRouter (OpenAI Compatible)",
        "model": "xiaomi/mimo-v2.5@preset/high",
        "enable_thinking": true,
      },
      {{- if .work }}
      {
        "provider": "litellm",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true,
        "effort": "high",
      },
      {{- end }}
    ],
    "default_model": {
      "provider": "OpenRouter (OpenAI Compatible)",
      "model": "deepseek/deepseek-v4-flash-0731@preset/high",
      "enable_thinking": true,
    },
    "subagent_model": {
      "provider": "OpenRouter (OpenAI Compatible)",
      "model": "deepseek/deepseek-v4-flash-0731@preset/high",
      "enable_thinking": true,
    },
    "inline_assistant_model": {
      "provider": "OpenRouter (OpenAI Compatible)",
      "model": "deepseek/deepseek-v4-flash-0731@preset/high",
      "enable_thinking": true,
    },
    "commit_message_model": {
      "provider": "OpenRouter (OpenAI Compatible)",
      "model": "deepseek/deepseek-v4-flash-0731@preset/high",
      "enable_thinking": false,
    },
    "thread_summary_model": {
      "provider": "OpenRouter (OpenAI Compatible)",
      "model": "z-ai/glm-5.2@preset/high",
      "enable_thinking": false,
    },

    "default_profile": "agent",
    "profiles": {
      "write": {
        "name": "Write",
        "enable_all_context_servers": false,
      },
      "agent": {
        "name": "Coding Agent",
        "enable_all_context_servers": true,
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true,
        },
        "context_servers": {
          {{- includeTemplate "private_dot_config/zed/.mcp/enabled-tools.tmpl" . }}
        },
      },
    },
    "tool_permissions": {
      "tools": {
        // Integrated Tools
        "fetch": { "default": "allow" },
        "create_directory": { "default": "allow" },
        "copy_path": { "default": "allow" },
        "delete_path": { "default": "allow" },
        "terminal": {
          "always_allow": [
            {
              // standard unix commands that are safe to run in a terminal
              "pattern": "^(ls|grep|sed|git|awk|find|xargs|cat|head|tail|echo|cat|wc|cut|sort|uniq|tr|diff|comm|cmp|stat|file|dirname|basename|readlink|realpath|which|whereis|type)",
            },
            {
              "pattern": "^command -v",
            },
            {
              "pattern": "^gh (repo read-file|repo read-dir|--version)",
            },
            {
              "pattern": "^pre-commit run",
            },
            {
              "pattern": "^kustomize build|kubectl kustomize",
            },
          ],
        },

        {{- includeTemplate "private_dot_config/zed/.mcp/tool-permissions.tmpl" . }}
      },
    },
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "docs.github.com",
        "raw.githubusercontent.com",
        "docs.api.stackit.cloud",
        "docs.renovatebot.com",
      ],
      "allow_all_hosts": false,
    },
  },
  "context_servers": {
    {{- includeTemplate "private_dot_config/zed/.mcp/context-servers.tmpl" . }}
  },
  "agent_servers": {
    "{{ if .personal }}github-copilot-cli{{ end }}{{ if .work }}claude-acp{{ end }}": {
      "type": "registry",
    },
  },
  "language_models": {
    {{ if .work -}}
    "litellm": {
      "api_url": "{{ (index (bitwarden "item" "AI Keys").login.uris 0).uri }}",
    },
    {{- end }}
    "openai_compatible": {
      "OpenRouter (OpenAI Compatible)": {
        "api_url": "https://openrouter.ai/api/v1",
        "available_models": [
          {
            "display_name": "GLM 5.2 (High)",
            "name": "z-ai/glm-5.2@preset/high",
            "max_tokens": 1048576,
            "max_output_tokens": 131072,
            "reasoning_effort": "high",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "prompt_cache_key": false,
              "max_tokens_parameter": true,
            },
          },
          {
            "display_name": "DeepSeek V4 Flash (High)",
            "name": "deepseek/deepseek-v4-flash@preset/high",
            "max_tokens": 1048576,
            "max_output_tokens": 393200,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "prompt_cache_key": false,
              "max_tokens_parameter": true,
            },
          },
          {
            "display_name": "DeepSeek V4 Flash 0731 (High)",
            "name": "deepseek/deepseek-v4-flash-0731@preset/high",
            "max_tokens": 1048576,
            "max_output_tokens": 393200,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "prompt_cache_key": false,
              "max_tokens_parameter": true,
            },
          },
          {
            "display_name": "MiMo V2.5 (High)",
            "name": "xiaomi/mimo-v2.5@preset/high",
            "max_tokens": 1048576,
            "max_output_tokens": 131072,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "prompt_cache_key": false,
              "max_tokens_parameter": true,
            },
          },
          {
            "display_name": "MiMo V2.5 Pro (High)",
            "name": "xiaomi/mimo-v2.5-pro@preset/high",
            "max_tokens": 1048576,
            "max_output_tokens": 131072,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "prompt_cache_key": false,
              "max_tokens_parameter": true,
            },
          },
          {
            "display_name": "Kimi K3 (Default)",
            "name": "moonshotai/kimi-k3",
            "max_tokens": 1048576,
            "max_output_tokens": 1048576,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "prompt_cache_key": false,
              "max_tokens_parameter": true,
            },
          },
        ],
      },
    },
  },
}
