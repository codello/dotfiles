// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Feature Flags
  "feature_flags": {
    "sandboxing": "on",
    "create-thread-tool": "on",
  },

  // Extensions
  "auto_install_extensions": {
    // Themes and Visuals
    "jetbrains-themes": true,
    "catppuccin-icons": true,
    // Languages
    "comment": true, // highlights todo comments
    "dockerfile": true,
    "gotmpl": true,
    "html": true,
    "toml": true,
  },

  // General Settings
  "base_keymap": "JetBrains",
  "cli_default_open_behavior": "new_window",

  // Appearance & Layout
  "icon_theme": "Catppuccin Latte",
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark",
  },
  "drop_target_size": 0.35,
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "status_bar": {
    "line_endings_button": true,
  },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "diagnostic_badges": true,
  },
  "git_panel": {
    "dock": "left",
    "sort_by": "path",
  },

  // Fonts
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13.0,
  "buffer_font_weight": 300.0,
  "buffer_line_height": {
    "custom": 1.35,
  },

  // Editor Experience
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "close_on_file_delete": true,
  "auto_signature_help": false,
  "show_signature_help_after_edits": true,
  "gutter": {
    "min_line_number_digits": 3,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.75,
  },
  "colorize_brackets": true,
  "wrap_guides": [80, 120],
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "scrollbar": {
    "show": "system",
  },
  "unnecessary_code_fade": 0.4,

  // Code Intelligence
  "inlay_hints": {
    "enabled": true,
    "edit_debounce_ms": 0,
    "scroll_debounce_ms": 0,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "padding": 8,
    },
  },

  // Git Integration
  "diff_view_style": "unified",
  "git": {
    "branch_picker": {
      "show_author_name": true,
    },
  },

  // Terminal
  "terminal": {
    "font_weight": 300.0,
    "font_family": "JetBrainsMono Nerd Font",
    "cursor_shape": "bar",
  },

  // Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Profiles
  "profiles": {
    "Presenting (Dark)": {
      "settings": {
        "theme": "JetBrains Dark",
        "agent_buffer_font_size": 18.0,
        "buffer_font_size": 18.0,
        "ui_font_size": 18.0,
      },
    },
    "Presenting (Light)": {
      "settings": {
        "theme": "JetBrains Light",
        "agent_buffer_font_size": 18.0,
        "buffer_font_size": 18.0,
        "ui_font_size": 18.0,
      },
    },
  },

  // Fily Type Associations
  "file_types": {
    "GitHub Actions": ["**/.github/workflows/*"],
    "Go Text Template": ["*.tpl", "**/templates/*.yaml"],
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml",
    ]
  },
  "file_scan_exclusions": ["...", "**/._*"],

  // Language-specific Settings
  "languages": {
    "JavaScript": {
      "preferred_line_length": 120,
      "prettier": {
        "singleQuote": false,
      },
    },
    "Go Text Template": {
      "tab_size": 2,
    },
  },

  // LSP Settings
  "lsp": {
    "powershell-es": {
      "settings": {
        "powershell": {
          "codeFormatting": {
            "openBraceOnSameLine": true,
            "addWhitespaceAroundPipe": true,
            "trimWhitespaceAroundPipe": true,
            "ignoreOneLineBlock": true,
            "useCorrectCasing": true,
          },
        },
      },
    },
  },

  // AI Settings
  "show_edit_predictions": {{ .personal }},
  "edit_predictions": {
    "allow_data_collection": "no",
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "provider": "copilot",
  },
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "right",
    },
    "show_turn_stats": true,
    "thinking_display": "auto",
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "enable_feedback": false,

    "commit_message_include_project_rules": false,
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "openrouter/auto",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "openrouter/free",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "deepseek/deepseek-v4.1-flash",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openrouter",
        "model": "deepseek/deepseek-v4-flash-0731",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3-flash",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3",
        "enable_thinking": true,
        "effort": "high",
      },
      {{- if .work }}
      {
        "provider": "litellm",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true,
        "effort": "high",
      },
      {{- end }}
    ],
    "default_model": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
      "effort": "high",
    },
    "subagent_model": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
      "effort": "high",
    },
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
      "effort": "low",
    },
    "commit_message_model": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash-0731",
      "enable_thinking": false,
    },
    "thread_summary_model": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash-0731",
      "enable_thinking": false,
    },

    "default_profile": "agent",
    "profiles": {
      "write": {
        "name": "Write",
        "enable_all_context_servers": false,
      },
      "agent": {
        "name": "Coding Agent",
        "enable_all_context_servers": true,
        "tools": {
          "ask_user": true,
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true,
        },
        "context_servers": {
          {{- includeTemplate "private_dot_config/zed/.mcp/profile-tools.tmpl" (dict "data" . "profile" "agent") }}
        },
      },
      "research": {
        "name": "Deep Research",
        "enable_all_context_servers": true,
        // Research: read, search, and probe. Restricted writing tools.
        "tools": {
          "ask_user": true,
          "diagnostics": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "go_to_definition": true,
          "grep": true,
          "list_directory": true,
          "read_file": true,
          "search_web": true,
          "skill": true,
          "terminal": true,
        },
        "context_servers": {
          {{- includeTemplate "private_dot_config/zed/.mcp/profile-tools.tmpl" (dict "data" . "profile" "research") }}
        },
      },
    },
    "tool_permissions": {
      "tools": {
        // Integrated Tools
        "fetch": { "default": "allow" },
        "create_directory": { "default": "allow" },
        "copy_path": { "default": "allow" },
        "delete_path": { "default": "allow" },
        "move_path": { "default": "allow" },
        "edit_file": { "default": "allow" },
        "write_file": { "default": "allow" },
        "terminal": {
          "default": "allow",
          "always_confirm": [
            // Exfiltration guards
            // The sandbox network allowlist is the primary security boundary.
            // These are additional per-command guards.
            { "pattern": "^cargo publish" },
            { "pattern": "^npm publish" },
            { "pattern": "^twine upload" },
            { "pattern": "^helm push" },
            // Generic HTTP clients can reach every allowlisted host
            { "pattern": "^(curl|wget|https?)\\b" },
            // Keychain access and macOS automation
            { "pattern": "^(security|osascript)\\b" },
            // Wrappers bypass per-command pattern matching
            { "pattern": "^(ba|z|da|k)?sh\\s+-[a-zA-Z]*c\\b" },
          ],
          "always_deny": [
            // never run find against the home directory
            { "pattern": "^find ({{ .chezmoi.homeDir }}|~)/?\\s" },
          ],
        },
        {{- includeTemplate "private_dot_config/zed/.mcp/tool-permissions.tmpl" . }}
      },
    },
    "sandbox_permissions": {
      "allow_all_hosts": false,
      "network_hosts": [
        // GitHub content and docs. github.com itself is not allowlisted:
        // Non-MCP push/clone and GitHub API access should always prompt.

        // GitHub Content and Docs
        "docs.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",

        // Documentation
        "docs.stackit.cloud",     // STACKIT
        "docs.api.stackit.cloud", // STACKIT
        "docs.renovatebot.com",   // Renovate
        "pkg.go.dev",             // GoDoc

        // Package registries for dependency downloads
        "crates.io",              // Rust
        "static.crates.io",       // Rust
        "index.crates.io",        // Rust
        "registry.npmjs.org",     // NPM
        "proxy.golang.org",       // Go
        "sum.golang.org",         // Go
        "pypi.org",               // Python
        "files.pythonhosted.org", // Python
      ],
      "write_paths": [
        // Helm config and caches
        "{{ .chezmoi.homeDir }}/.config/helm/",
        "{{ .chezmoi.homeDir }}/Library/Caches/helm/",
        // uv caches
        "{{ .chezmoi.homeDir }}/Library/Caches/uv/",
        // Terraform Cache
        "{{ .chezmoi.homeDir }}/Library/Caches/terraform/",
        // Go Caches
        "{{ .chezmoi.homeDir }}/Library/Caches/go/",
        "{{ .chezmoi.homeDir }}/Library/Caches/go-build/",
        "{{ .chezmoi.homeDir }}/.local/share/go/",
        // Cargo
        "{{ .chezmoi.homeDir }}/.cargo/",
        // npm
        "{{ .chezmoi.homeDir }}/.npm/",
        // pre-commit
        "{{ .chezmoi.homeDir }}/Library/Caches/pre-commit/",
      ],
    },
  },
  "context_servers": {
    {{- includeTemplate "private_dot_config/zed/.mcp/context-servers.tmpl" . }}
  },
  "agent_servers": {
    "{{ if .personal }}github-copilot-cli{{ end }}{{ if .work }}claude-acp{{ end }}": {
      "type": "registry",
    },
  },
  "language_models": {
    {{- if .work }}
    "litellm": {
      "api_url": "{{ (index (bitwarden "item" "AI Keys").login.uris 0).uri }}",
    },
    {{- end }}
    "open_router": {
      "available_models": [
        {
          "display_name": "DeepSeek V4 Flash 0731",
          "name": "deepseek/deepseek-v4-flash-0731",
          "max_tokens": 1048576,
          "max_output_tokens": 393200,
          "mode": { "type": "adaptive" },
          "reasoning_effort": "high",
          "supports_images": false,
          "supports_tools": true,
          "provider": {
            "only": ["relace", "reka", "fireworks"],
          },
        },
        {
          "display_name": "DeepSeek V4.1 Flash",
          "name": "deepseek/deepseek-v4.1-flash",
          "max_tokens": 1048576,
          "max_output_tokens": 393200,
          "mode": { "type": "adaptive" },
          "reasoning_effort": "high",
          "supports_images": true,
          "supports_tools": true,
          "provider": {
            "only": ["fireworks"],
          },
        },
        {
          "display_name": "GLM 5.3 Flash",
          "name": "z-ai/glm-5.3-flash",
          "max_tokens": 1048576,
          "max_output_tokens": 131072,
          "reasoning_effort": "high",
          "supports_images": true,
          "supports_tools": true,
          "provider": {
            "only": ["together"], // fireworks, baseten, coreweave
          }
        }
      ],
    },
  },
}
