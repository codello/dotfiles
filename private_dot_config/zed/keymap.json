// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "cmd-shift-n": "workspace::NewWindow",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-cmd-s": "workspace::SaveWithoutFormat",
    },
  },
  {
    // workaround for https://github.com/zed-industries/zed/issues/62696
    "context": "BufferSearchBar && !in_replace > Editor",
    "bindings": {
      "shift-enter": "search::SelectPreviousMatch",
    },
  },
  {
    // we specifically want Shift-Enter to insert a newline in the Agent panel
    "context": "AgentPanel > MessageEditor > Editor",
    "bindings": {
      "shift-enter": "editor::Newline",
    },
  },
]
