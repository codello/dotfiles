{{- /* Template the global tool permissions in the format
       `mcp:<mcp-name>:<tool-name>`: { "default": "<permission>" }` */ -}}
{{- $first := true -}}
{{- $files := printf "%s/%s" .chezmoi.sourceDir "private_dot_config/zed/.mcp/*.toml" | glob }}
{{- range $file := $files }}
    {{- $mcps := fromToml (includeTemplate $file $) -}}
    {{- range $name, $mcp := $mcps }}
        {{- if hasKey $mcp "tools" }}
        {{- if not $first }}{{ printf "\n" }}{{ end }}
        {{- $first = false }}
        // {{ $name }} Tools
            {{- range $tool, $enabled := $mcp.tools }}
                {{- if kindIs "string" $enabled }}
                    {{- $perm := $enabled }}
                    {{- if eq $enabled "allow-when-enabled" }}{{- $perm = "allow" }}{{- end }}
        "mcp:{{ $name }}:{{ $tool }}": { "default": "{{ $perm }}" },
                {{- end }}
            {{- end }}
        {{- end }}
    {{- end }}
{{- end -}}
