{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "git-submodules": {
    "enabled": true
  },
  "regexManagers": [
    {
      "fileMatch": ["(^|\\/).chezmoiexternal.toml$"],
      "matchStrings": [
        "url\\s*=\\s*\"https:\\/\\/github.com\\/(?<depName>[^\\/]+\\/[^\\/]+)\\/archive\\/refs\\/tags\\/(?<currentValue>\\d+(\\.\\d+)*).zip\"",
        "url\\s*=\\s*\"https:\\/\\/raw\\.githubusercontent\\.com\\/(?<depName>[^\\/]+\\/[^\\/]+)\\/refs\\/tags\\/(?<currentValue>[^\\/]+)\\/"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ]
}
